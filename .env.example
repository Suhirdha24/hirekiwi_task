# ==============================================================================
# CareerHub QA Assessment Portal - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Note: NEVER commit .env or expose credentials in version control.

# Application Server Port (Default: 3000)
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<appName>
# Note: Ensure your public IP address is whitelisted in MongoDB Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/careerhub?retryWrites=true&w=majority&appName=Cluster0

# Client Origin for CORS configuration (optional, defaults to * in development)
CLIENT_ORIGIN=http://localhost:3000

# Administrative Passkey for Recruiter Management Console
ADMIN_KEY=your_secure_admin_passkey_here
